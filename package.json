{
  "name": "stream-ring-notes",
  "version": "1.1.0",
  "description": "Publish Instagram Notes from signed Sandbar Stream Ring captures",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "login": "tsx scripts/login-wizard.ts",
    "test": "vitest run",
    "setup": "node scripts/setup.mjs",
    "import-session": "tsx scripts/import-session.ts",
    "install-browser": "playwright install chromium",
    "check-stream": "node scripts/check-stream.mjs",
