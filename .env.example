# Run npm run setup to create .env and generate API_KEY.
API_KEY=
HOST=127.0.0.1
PORT=4317

# Read the account-risk section in the README before enabling.
ENABLE_PRIVATE_API=false
IG_PROFILE_DIR=./data/ig-profile
IG_HEADLESS=true
IG_CHROME_CHANNEL=
NOTE_CHAR_LIMIT=60
# 0 = followers you follow back, 1 = Close Friends
DEFAULT_AUDIENCE=0

# Paste the full swh_ secret from Stream iOS to enable signed delivery.
STREAM_WEBHOOK_SECRET=
STREAM_HOST=127.0.0.1
STREAM_PORT=8779
